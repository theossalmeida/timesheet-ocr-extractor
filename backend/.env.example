# Gemini is used only as a remote fallback for scanned/image-only PDF pages
# after pdfplumber and local Tesseract fail.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-pro-preview
MISTRAL_API_KEY=your_mistral_api_key_here
# Only set this if `tesseract --version` fails in your terminal even though
# Tesseract is installed (i.e. it's not on PATH). Point it at the actual
# tesseract.exe, e.g. on Windows:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
ENVIRONMENT=development
MAX_FILE_SIZE_MB=50
CORS_ORIGINS=["http://localhost:3000"]
# When accessing through a tunnel, set this to the frontend's public tunnel URL
# (or ["*"] to allow any origin - fine here since no cookies/credentials are used).
LOG_LEVEL=INFO

# Optional local vision fallback after Gemini, useful for local experiments only.
# LM Studio: start the local server and expose it on port 1234.
# Use the exact model id shown by GET /v1/models if your LM Studio name differs.
# LOCAL_VISION_OCR_BASE_URL=http://localhost:1234
# LOCAL_VISION_OCR_MODEL=PaddleOCR-VL-1.6-8bit
# LOCAL_VISION_OCR_PROVIDER=lmstudio
# LOCAL_VISION_OCR_TIMEOUT_SECONDS=180
# LOCAL_VISION_OCR_DPI=300
# LOCAL_VISION_OCR_NUM_CTX=8192
#
# Ollama remains supported if needed:
# LOCAL_VISION_OCR_PROVIDER=ollama
# LOCAL_VISION_OCR_BASE_URL=http://localhost:11434