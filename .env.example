GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
ENVIRONMENT=development
MAX_FILE_SIZE_MB=50
CORS_ORIGINS=["http://localhost:3000"]
# For tunnel access, set to the frontend's public tunnel URL or ["*"].
LOG_LEVEL=INFO

# Optional OCR fallback for image-only/handwritten pages after Tesseract fails.
# Requires an Ollama-compatible vision model server reachable from this backend.
# LOCAL_VISION_OCR_BASE_URL=http://100.79.108.26:11434
# LOCAL_VISION_OCR_MODEL=qwen2.5vl:7b
# LOCAL_VISION_OCR_TIMEOUT_SECONDS=120
# LOCAL_VISION_OCR_DPI=160
